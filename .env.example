# IdentityShield v3 environment variables
# Copy to ".env" in the project root (git-ignored). Fill only what you use. Never commit real values.

# --- Core & v3 Flags ---
V3_ENABLED=
ANALYST_TOKEN=
DRY_RUN=
CONSOLE_BASE_URL=

# --- Ingest Service (Port 8001, exposed via ngrok) ---
# Format: keyid:secret,keyid2:secret2 (use long random secrets, 32+ characters)
INGEST_KEYS=
INGEST_ALLOWED_ORIGINS=

# --- Threat Enrichment Providers ---
# Comma-separated provider IDs: ipinfo_lite,ipapi,abuseipdb,greynoise,otx
ENRICH_PROVIDERS=
IPINFO_TOKEN=
ABUSEIPDB_KEY=
GREYNOISE_KEY=
OTX_KEY=
VT_KEY=
MAXMIND_LICENSE_KEY=

# --- Optional LLM Narrator (ollama | gemini | groq | openrouter) ---
LLM_ENABLED=
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=
OPENROUTER_API_KEY=

# --- Email Notifications (off | outbox | smtp) ---
EMAIL_MODE=
ADMIN_EMAIL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
EMAIL_MIN_RISK=
EMAIL_MAX_PER_HOUR=

# --- SMTP Server Configuration ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=
SMTP_SSL=
SMTP_TIMEOUT_SECONDS=

# --- ngrok (documentation only; the ngrok agent stores its own token) ---
NGROK_AUTHTOKEN=
